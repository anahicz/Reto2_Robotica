# Configuración local del RB-2.
# La corrida validada usó ROS_DOMAIN_ID=112 y Discovery Server 172.51.1.17:11811.
# Si cambia la red del laboratorio, edita este archivo después de copiarlo como network.env.

ROS_DISTRO=humble
WORKSPACE="$HOME/ros2_ws"

ROS_DOMAIN_ID=112
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DISCOVERY_SERVER=172.51.1.17:11811
FASTRTPS_DEFAULT_PROFILES_FILE="$HOME/super_client_configuration_file.xml"

# Solo se usa por scripts/analyze_item3.sh.
# exportar_csv.py y metricas.py pertenecían al kit de análisis usado en el laboratorio.
ANALYSIS_DIR="$HOME/ros2_ws/src/kit_reto_alumno/analisis"
